# yubiOS first-boot enrollment wizard
# Waits for a YubiKey to be detected, then prompts the user to enroll.
# Runs once (ConditionFirstBoot=yes) and marks itself complete.

[Unit]
Description=yubiOS YubiKey Enrollment Wizard (First Boot)
After=local-fs.target systemd-logind.service systemd-user-sessions.service network.target sshd.service
Wants=pcscd.service getty-pre.target
After=pcscd.service
# Order before getty-pre.target and all console/serial gettys so agetty does not
# start on /dev/console (/dev/ttyS2 or /dev/tty1) mid-wizard, call vhangup()
# (SIGHUP), or steal input from enroll.sh. Once enroll.sh finishes, getty starts.
Before=getty-pre.target getty.target serial-getty@ttyS2.service serial-getty@ttyAMA0.service serial-getty@ttyS0.service getty@tty1.service kmsconvt@tty1.service
# ADR-024 / OMN-18: run the first-boot CHIPSEC platform check first and gate
# enrollment on its result. Wants= (not Requires=) so a skipped or failed
# CHIPSEC unit never takes enrollment down with it; the gate below decides.
Wants=yubiOS-chipsec-firstboot.service
After=yubiOS-chipsec-firstboot.service
ConditionFirstBoot=yes
ConditionPathExists=!/var/lib/yubiOS/.enrolled
# ADR-016: gate enrollment on full measured-boot (systemd >= 261 required)
ConditionSecurity=measured-os

[Service]
Type=oneshot
Environment="PATH=/usr/lib/systemd:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
RemainAfterExit=yes
TTYPath=/dev/console
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=tty
StandardError=tty
# ADR-024 / OMN-18: skip (block) enrollment when the first-boot CHIPSEC
# status file says RESULT=FAILED; WARN/PASS/absent proceed. ExecCondition=
# exit 1 skips the unit, so the ExecStartPost= .enrolled marker is not written
# and enrollment stays pending until the firmware finding is resolved.
ExecCondition=/usr/lib/yubiOS/chipsec/check-enrollment-gate.sh
# Settle delay so late kernel/NIC link messages finish printing before the
# wizard clears the console and reads stdin.
ExecStartPre=/bin/sleep 5
ExecStart=/usr/lib/yubiOS/enroll.sh
ExecStartPost=/bin/mkdir -p /var/lib/yubiOS
ExecStartPost=/bin/touch /var/lib/yubiOS/.enrolled
# ADR-016 / systemd.exec(5): deny network filesystems for the enrollment service.
# RestrictFileSystems= (added systemd v250) is enforced via the LSM eBPF hook.
# Deny-list form: local block/API filesystems (btrfs, ext4, tmpfs, proc, sysfs)
# stay accessible; only @network types (NFS, CIFS, ...) are blocked.
# Prerequisite VERIFIED 2026-06-25 (BLOCKER-007 cleared, PAIR-28A):
# CONFIG_BPF_LSM=y is set AND in the active CONFIG_LSM stack on the v261 base
# quay.io/fedora/fedora-bootc:45@sha256:b7b34d8720b2e0ccaba980fd92347e7820051496ca0e639704172c6f3fb8877d
# so this directive is enforced, not silently ignored.
RestrictFileSystems=~@network

[Install]
WantedBy=first-boot-complete.target multi-user.target
