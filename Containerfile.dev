# yubiOS DEV/TEST image — adds swu2f Layer 2 (passless, in-guest software CTAP2
# FIDO2 authenticator) on top of the base yubiOS image, for hardware-free bcvk
# CI (LUKS2-FIDO2 + systemd-homed + enrollment e2e, tests/vm/test-luks-fido2-ci.sh
# and test-fido2-enrollment.sh). Published as 0mniteck/yubios:dev / :dev-<sha>
# (ADR-026) — a distinct tag namespace from :latest, never the same artifact.
#
# TEST-ONLY. The production trust anchor stays the YubiKey FIDO2 device
# (ADR-003). passless is never present in a production image — this
# Containerfile is the ONLY place it gets installed, and it is never referenced
# by yubiOS-ci.yml's build/push path.
#
# Reuses the exact same install script the mkosi TEST profile uses
# (mkosi.conf.d/test/install-swu2f-authenticator.sh) so the mkosi and bootc
# paths ship byte-identical swu2f tooling, per ADR-006's "both paths behave
# identically at runtime" principle.
#
# Build through yubiOS-bake.hcl so the production image is supplied as the
# policy-checked `yubios-base` named context instead of a daemon-local tag.
# Standalone equivalent:
#   docker buildx build -f Containerfile.dev \
#     --build-context yubios-base=docker-image://<pinned-yubios-ref> .

ARG BASE_IMAGE=yubios-base
FROM ${BASE_IMAGE} AS rootfs

ARG SOURCE_DATE_EPOCH

# Ensure bootupd is present for the destructive hardware-test leg
# (tests/vm/test-luks-fido2.sh runs `bcvk native-to-disk` which calls
# `bootc install to-disk`; bootc refuses ostree installs without bootupd).
# The production Containerfile installs bootupd at line 37 (commit 1b4638d,
# OMN-95), but the dev image's `yubios-base` context inheritance did not
# surface bootupd in the published :dev tag as of run #132 / 2026-07-29.
# Re-install here so the dev image carries it explicitly and the
# destructive hardware leg stops dying at "Installing to disk: bootupd
# is required for ostree-based installs" (errors/bcvk native_to_disk.rs:262).
RUN dnf -y --setopt=history_record=false --setopt=install_weak_deps=False \
      --setopt=metadata_expire=never \
      --setopt=updates-testing.excludepkgs=kernel-headers,parted,pcsc-lite,pcsc-lite-ccid,pcsc-lite-libs,python3-devel,python3-keyring,python3-pip \
      install bootupd && \
    rm -f /var/cache/dnf/*.lock /var/cache/dnf/*.pid /run/dnf5.lock /run/dnf.lock 2>/dev/null || true && \
    dnf -y --setopt=install_weak_deps=False clean all && \
    rm -rf /var/cache/dnf /var/cache/libdnf5 /run/dnf /var/log/dnf* /var/log/libdnf* /var/lib/dnf/repos /var/lib/dnf/system-repo.lock /usr/lib/sysimage/libdnf5/transaction_history.sqlite* /usr/lib/sysimage/libdnf5/*.toml && \
    rm -f /etc/machine-id /var/lib/systemd/random-seed && \
    ! test -e /etc/machine-id && \
    ! test -e /var/lib/systemd/random-seed

COPY mkosi.conf.d/test/install-swu2f-authenticator.sh /tmp/install-swu2f-authenticator.sh
RUN chmod +x /tmp/install-swu2f-authenticator.sh && \
    /tmp/install-swu2f-authenticator.sh && \
    rm -f /tmp/install-swu2f-authenticator.sh && \
    rm -f /etc/machine-id /var/lib/systemd/random-seed

# ── composefs backend (upstream-recommended fix for OMN-149 / bootupd regression) ──
# The destructive hardware-test leg (tests/vm/test-luks-fido2.sh) calls
# `bcvk native-to-disk`, which runs `bootc install to-disk`. bootc's
# `bootupd_check_required` in crates/lib/src/install.rs demands a working
# `bootupd` in the source image's userland for the ostree backend -- and despite
# multiple fix attempts (production Containerfile line 37 in 1b4638d, Containerfile.dev
# line 36 in b8ba8574 / f58d6c14), the check has kept tripping on the destructive leg.
# Per bootc-dev/bootc issue #2093 + PR #2098, switching to the composefs backend
# bypasses this entire class of failures: bootc no longer requires bootupd when
# [composefs] enabled=true is set in /usr/lib/ostree/prepare-root.conf.
#
# The yubios-smoke test in yubiOS-bake.hcl still rejects composefs as a DRACUT MODULE
# (it checks for `add_dracutmodules+=" bootc "`, not composefs), so this backend
# switch does not break the smoke test -- dracut still uses the bootc module.
#
# belt-and-suspenders: keep the `RUN dnf install bootupd` block above so the ostree
# backend path still has bootupd if composefs is ever disabled downstream.
RUN install -Dm644 /dev/stdin /usr/lib/ostree/prepare-root.conf <<'EOF'
[composefs]
enabled = true
EOF

# ── TEST-ONLY: serial-console root autologin ──────────────────────
# Gives CI a route INTO the guest when SSH is not reachable. The fTPM chain
# (ci_test-vm.yml ftpm-qemu -> tests/vm/test-ftpm-qemu-ci.sh) boots this image
# under TF-A + OP-TEE + U-Boot, where bcvk's kernel-cmdline SSH credential never
# applies: U-Boot owns the boot, /etc is transient, root has no password, and no
# network is configured. A serial getty with root autologin is the only remaining
# way to execute tests/vm/verify-tpm0-pcr-extend.sh (checks 3-5: TPM2_Startup,
# PCR read, PCR extend) inside that guest.
#
# Drop-ins live under /usr/lib, not /etc, so they survive bootc's /etc 3-way
# merge (see the bootc filesystem rules: prefer /usr for non-machine-local
# config). ExecStart is cleared first because a drop-in appends to the unit's
# existing ExecStart rather than replacing it.
#
# NEVER in production. Root autologin on a console is a total local-access
# bypass of pam_u2f (ADR-003). This exists only in Containerfile.dev, which only
# ci_dev_image.yml builds and only ever tags :dev / :dev-<sha> (ADR-026).
RUN install -Dm644 /dev/stdin /usr/lib/systemd/system/serial-getty@.service.d/10-yubiOS-test-autologin.conf <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty -o '-p -- \\u' --autologin root --keep-baud 115200,57600,38400,9600 - $TERM
EOF

RUN install -Dm644 /dev/stdin /usr/lib/systemd/system/getty@.service.d/10-yubiOS-test-autologin.conf <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty -o '-p -- \\u' --autologin root --noclear - $TERM
EOF

# systemd-getty-generator only spawns a serial getty for the console= karg, and
# under U-Boot we do not control the cmdline. Wire both consoles unconditionally:
# ttyAMA0 is the QEMU virt ARM64 console, ttyS0 the amd64 one. The unit BindsTo
# its dev-%i.device, so the one whose tty is absent simply never starts.
RUN install -d /usr/lib/systemd/system/getty.target.wants && \
    ln -sf ../serial-getty@.service \
      /usr/lib/systemd/system/getty.target.wants/serial-getty@ttyAMA0.service && \
    ln -sf ../serial-getty@.service \
      /usr/lib/systemd/system/getty.target.wants/serial-getty@ttyS0.service

# Fail the build if the drop-ins did not land where systemd will read them.
RUN test -s /usr/lib/systemd/system/serial-getty@.service.d/10-yubiOS-test-autologin.conf && \
    test -s /usr/lib/systemd/system/getty@.service.d/10-yubiOS-test-autologin.conf && \
    grep -q -- "--autologin root" \
      /usr/lib/systemd/system/serial-getty@.service.d/10-yubiOS-test-autologin.conf && \
    test -L /usr/lib/systemd/system/getty.target.wants/serial-getty@ttyAMA0.service

# ADR-031 rule 1: default yubiOS images ship virtio-gpu only. devtmpfs
# re-creates /dev/vfio from the kernel device tree after the tmpfiles
# remove + udev rule fire; this systemd oneshot is the post-sysinit
# belt-and-suspenders. Wire its multi-user.target.wants/ symlink here
# using the same pattern as the getty.target.wants links above. See
# refs/vgpu-vfio-user-trust-boundary-2026-07-25.md.
RUN install -d /usr/lib/systemd/system/multi-user.target.wants && \
    ln -sf ../yubiOS-no-vfio-purge.service \
      /usr/lib/systemd/system/multi-user.target.wants/yubiOS-no-vfio-purge.service && \
    test -L /usr/lib/systemd/system/multi-user.target.wants/yubiOS-no-vfio-purge.service

# ── Composefs digest pinning & single-layer UKI parity (d4b95e208f / 6414edfee4) ──
# Clean build leftovers, remove the base image's pre-built UKI so ukify hashes this
# dev rootfs, normalize mtimes to SOURCE_DATE_EPOCH, rebuild the UKI against this
# rootfs, re-pin mtimes in prefinal, and squash into a single FROM scratch layer so
# the layer-computed composefs digest and the UKI's embedded composefs= digest match.
RUN rm -f /var/lib/systemd/catalog/database && \
    find /tmp -mindepth 1 -delete && \
    find /run -mindepth 1 -maxdepth 1 ! -name systemd -exec rm -rf {} + && \
    find /run/systemd -mindepth 1 -maxdepth 1 ! -name resolve -exec rm -rf {} +

RUN rm -f /etc/machine-id /var/lib/systemd/random-seed && \
    ! test -e /etc/machine-id && \
    ! test -e /var/lib/systemd/random-seed

RUN rm -f /boot/EFI/Linux/*.efi /boot/*.dump && \
    mkdir -p /boot/EFI/Linux /boot/EFI/BOOT /boot/EFI/systemd

RUN find / -xdev -mindepth 1 \( -path /proc -o -path /sys -o -path /dev -o -path /etc/hosts -o -path /etc/resolv.conf -o -path /etc/hostname -o -path /run/systemd/resolve \) -prune -o -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} + && \
    touch -h -d "@${SOURCE_DATE_EPOCH}" /

FROM rootfs AS uki
RUN --mount=type=bind,from=rootfs,target=/target set -- /target/usr/lib/modules/*/ && \
    kver="$(basename "$1")" && \
    mkdir -p /out && \
    bootc container ukify --rootfs /target -- --output "/out/${kver}.efi"

FROM rootfs AS prefinal
COPY --from=uki /out/ /boot/EFI/Linux/
RUN ! test -e /etc/machine-id && ! test -e /var/lib/systemd/random-seed
ARG SOURCE_DATE_EPOCH
RUN touch -h -d "@${SOURCE_DATE_EPOCH}" / /run /boot /boot/EFI /boot/EFI/Linux /boot/EFI/systemd /boot/EFI/BOOT

FROM scratch
# hadolint ignore=DL3067
COPY --from=prefinal / /
LABEL containers.bootc="1" ostree.bootable="true"
LABEL yubiOS.image.kind="dev-test"
LABEL yubiOS.image.warning="TEST-ONLY: ships the passless swu2f software FIDO2 authenticator AND serial/tty root autologin (local-access bypass of pam_u2f). Never use in production. See ADR-003, ADR-026."
CMD ["/sbin/init"]
