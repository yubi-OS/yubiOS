  "documented_contract_notes": {
    "snapback_detect (CONTRACTS.md section 4)": "inversion iff sign(realized) OPPOSES sign(predicted); realized 0 neutral; predicted 0 no direction; consecutive inversions group into runs, agreeing or neutral cycle breaks a run; snapback iff any run length >= 2; verdicts only, never auto-actions",
    "hysteresis_rollup (CONTRACTS.md section 2)": "supersedes chain root<-...<-active closes into one loop oldest->active; area per loop = sum |predicted_delta - realized_delta| over WHOLE chain; mean_abs = sum_abs/len(chain); active_rows = rows no other row supersedes; n_cycles = number of loops; unknown supersedes -> root; supersedes cycle -> leftover singleton loops; empty -> all zeros",
    "parity tolerance rule": "1e-9 * (1 + |expected|); 0.05 for the 102.86 anchor; 0.01 for its mean"
  }
